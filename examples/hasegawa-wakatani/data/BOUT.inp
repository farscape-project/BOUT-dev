#
# Hasegawa-Wakatani test case
#

timestep = 1   # Output timestep
nout = 100      # Number of output steps

MYG = 0  # No need for Y communications

periodicX = true  # Domain is periodic in X

[mesh]
Lx = 50.176
Ly = 1.0
Lz = 50.176

nx = 36  # Note 4 guard cells in X
ny = 1 
nz = 32  # Periodic, so no guard cells in Z

dx = Lx/(nx-4)
dy = Ly/ny 
dz = Lz/nz


[solver]
mxstep = 1e5
atol = 1e-6

[output]
enabled = true 

[hw]
alpha = 1.0    # Adiabaticity (~ conductivity)
kappa = 0.5    # Density gradient drive
Dvort = 1.e-3   # Vorticity diffusion
Dn = 1.e-3   # Density diffusion

modified = false

bracket = 2  # 0 = std, 1 = simple, 2 = arakawa

[all]
scale = 0.0

bndry_all = dirichlet_o2

[vort]
scale = 0.1  # Fluctuation amplitude
function = mixmode(2*pi*x) * mixmode(z) # Fluctuation function
